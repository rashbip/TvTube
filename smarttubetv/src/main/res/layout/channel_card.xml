<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: You can't set layout dimension for Presenter's container -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:focusableInTouchMode="true"
             android:focusable="true"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content">
    <LinearLayout
                  android:id="@+id/channel_card_wrapper"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_width="@dimen/channel_card_width"
                  android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/channel_image"
            android:scaleType="centerCrop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:visibility="invisible"
            tools:ignore="ContentDescription"/>
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.MarqueeTextViewCompat
            android:id="@+id/channel_title"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/channel_card_pill_bg"
            android:textAlignment="textStart"/>
    </LinearLayout>
</FrameLayout>
