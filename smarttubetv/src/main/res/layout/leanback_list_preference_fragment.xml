<!-- Library: androidx:leanback:leanback-preference:1.0.0 -->
<!-- MOD: Modern YouTube-style translucent dialog and description panel -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lb_preference_decor_list_background"
    android:elevation="@dimen/lb_preference_decor_elevation"
    android:orientation="vertical"
    android:transitionGroup="false">

    <FrameLayout
        android:id="@+id/decor_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:transitionGroup="false">

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.TitleMarqueeTextViewCompat
            android:id="@+id/decor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:singleLine="false"
            android:maxLines="3"
            android:ellipsize="end" />
    </FrameLayout>

    <!-- Subtle divider line below title -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:background="#20FFFFFF" />

    <ScrollView
        android:id="@+id/message_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:visibility="gone">

        <TextView
            android:id="@android:id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="5dp"
            android:paddingStart="24dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp"
            tools:visibility="visible" />
    </ScrollView>

    <androidx.leanback.widget.VerticalGridView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:transitionGroup="true"/>

</LinearLayout>
